# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openrouter | ollama
LLM_PROVIDER=openrouter

# ── OpenRouter (cloud LLM — supports Claude, GPT-4o, Gemini, Llama, etc.) ────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# ── Ollama (local LLM — no API key required) ─────────────────────────────────
# Install: https://ollama.ai  |  Pull model: ollama pull llama3.2:1b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# ── OpenAI (optional direct OpenAI backend) ──────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# ── GPS home reference (used for scene → real-world GPS coordinate display) ──
# HOME_LAT=51.50722
# HOME_LON=-0.12750
# HOME_ALT_MSL=10.0
